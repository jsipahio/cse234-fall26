lab: SQLite3LabStarter.cpp SQLite3.hpp
	g++ SQLite3LabStarter.cpp -lsqlite3 --std=c++20 -o lab

example: SQLite3Example.cpp
	g++ SQLite3Example.cpp -lsqlite3 --std=c++17 -o example

